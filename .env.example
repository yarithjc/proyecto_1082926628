# Copiar como .env.local para desarrollo
NEXT_PUBLIC_APP_ENV=development

# === Supabase (PostgreSQL) ===
# Obtén estas variables de:
# 1. Dashboard de Supabase → Project Settings → API
# 2. En Vercel: Project Settings → Environment Variables
# (Si integras Supabase desde Vercel, las variables se auto-rellenan con un prefijo)

# URL pública de Supabase
SUPABASE_URL=https://your-project.supabase.co

# Clave pública (opcional, para autenticación)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Clave service_role (MANTÉN EN SECRETO - solo en backend)
# Necesaria para operaciones admin desde Route Handlers
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Conexión directa a PostgreSQL (para DDL - CREATE TABLE, ALTER, etc.)
# Disponible en Supabase Dashboard → Project Settings → Database → Connection Pooling
# O en Vercel si está integrado: VERCEL_POSTGRES_URL_NONPOOLING
POSTGRES_URL=postgresql://postgres:password@your-project.supabase.co:5432/postgres
